{
  "name": "@gemicore/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for Gemicore: app user auth, checkout, refunds, balances, billing, config and flags, notifications, realtime and webhook signature verification.",
  "keywords": [
    "gemicore",
    "sdk",
    "payments",
    "checkout",
    "subscriptions",
    "authentication",
    "webhooks",
    "realtime",
    "notifications",
    "api-client"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danolez1/gemicore-js.git"
  },
  "homepage": "https://gemicore.com/docs/reference/sdk",
  "bugs": {
    "url": "https://github.com/danolez1/gemicore-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "typescript": "^6.0.0"
  }
}
